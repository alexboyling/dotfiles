# Apps for a personal machine — presented as opt in/out by setup.sh
#
# NOTE: the dev tools (ghostty/cursor/raycast/tableplus) also appear in
# Brewfile.work. The duplication is deliberate — a few repeated lines beat
# maintaining and merging a third shared file.

cask "ghostty"   # terminal
cask "cursor"    # ide
cask "raycast"   # spotlight replacement
cask "tableplus" # gui for relational databases

cask "1password" # personal password manager
cask "spotify"
cask "slack"
cask "figma"

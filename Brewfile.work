# Apps for a work machine — presented as opt in/out by setup.sh
#
# NOTE: the dev tools (ghostty/cursor/raycast/tableplus) also appear in
# Brewfile.personal. The duplication is deliberate — a few repeated lines
# beat maintaining and merging a third shared file.

cask "ghostty"   # terminal
cask "cursor"    # ide
cask "raycast"   # spotlight replacement
cask "tableplus" # gui for relational databases

cask "slack"
cask "figma"
